# ==============================================================================
# LinkForge Guest Post Marketplace & Admin System - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client-safe)
# Only VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are exposed to client code
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# Server-Side Configuration (Protected - NEVER exposed to client or Vite bundle)
# ------------------------------------------------------------------------------
# Supabase Service Role Key for backend administration & trigger validation
SUPABASE_SERVICE_ROLE_KEY=""

# Email System Configuration (Resend API or SMTP)
# Provide RESEND_API_KEY for direct Resend delivery, or configure standard SMTP
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_EMAIL="noreply@linkforge.network"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# ------------------------------------------------------------------------------
# Google Workspace & Sheets Sync (Optional)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_API_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# ------------------------------------------------------------------------------
# Application Runtime
# ------------------------------------------------------------------------------
APP_URL="https://linkforge.network"
GEMINI_API_KEY=""
